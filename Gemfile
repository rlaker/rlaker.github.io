source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "jekyll-include-cache", group: :jekyll_plugins
gem "webrick", "~> 1.7"

# Jekyll 3.9's Stevenson logger subclasses ::Logger without calling super, so it
# breaks on logger >= 1.6 (which Ruby 3.3+ ships as a default gem).
gem "logger", "~> 1.5.3"
